{
  "project_name": "SmartShelf",
  "audit_type": "full_system_architecture_compliance_audit",
  "objective": "Perform a complete end-to-end audit of the SmartShelf project and compare the implemented system against all approved project documents, architecture specifications, database designs, PRD requirements, frontend specifications, backend specifications, security requirements, and business rules.",
  "audit_scope": {
    "frontend": true,
    "backend": true,
    "database": true,
    "security": true,
    "authentication": true,
    "rbac": true,
    "notifications": true,
    "reports": true,
    "api": true,
    "deployment": true,
    "performance": true,
    "code_quality": true,
    "documentation_alignment": true
  },
  "reference_documents": [
    "requirements_architecture_document",
    "functional_specification_document",
    "database_architecture_document",
    "prd",
    "design_document",
    "tech_stack_document",
    "frontend_execution_prompt",
    "backend_execution_prompt"
  ],
  "audit_execution_rules": {
    "perform_real_project_scan": true,
    "scan_all_source_code": true,
    "scan_all_routes": true,
    "scan_all_controllers": true,
    "scan_all_services": true,
    "scan_all_models": true,
    "scan_all_migrations": true,
    "scan_all_blade_files": true,
    "scan_all_components": true,
    "scan_all_api_endpoints": true,
    "scan_all_middlewares": true,
    "scan_all_policies": true,
    "scan_all_seeders": true
  },
  "frontend_audit": {
    "verify_authentication_first_flow": true,
    "verify_no_public_landing_page": true,
    "verify_smartshelf_branding": true,
    "verify_favicon": true,
    "verify_role_based_navigation": true,
    "verify_dashboard_implementation": true,
    "verify_module_pages": true,
    "verify_mobile_responsiveness": true,
    "verify_dark_mode": true,
    "verify_accessibility": true,
    "verify_form_validation": true,
    "verify_loading_states": true,
    "verify_error_states": true
  },
  "backend_audit": {
    "verify_service_repository_pattern": true,
    "verify_controller_structure": true,
    "verify_request_validation": true,
    "verify_business_rules": true,
    "verify_database_transactions": true,
    "verify_queue_usage": true,
    "verify_notification_system": true,
    "verify_report_generation": true,
    "verify_logging": true,
    "verify_audit_trails": true
  },
  "database_audit": {
    "verify_all_tables_exist": true,
    "verify_foreign_keys": true,
    "verify_indexes": true,
    "verify_soft_deletes": true,
    "verify_relationships": true,
    "verify_constraints": true,
    "verify_enum_integrity": true,
    "verify_seed_data": true,
    "verify_data_normalization": true
  },
  "security_audit": {
    "verify_rbac": true,
    "verify_permissions": true,
    "verify_policies": true,
    "verify_route_protection": true,
    "verify_csrf_protection": true,
    "verify_xss_protection": true,
    "verify_sql_injection_protection": true,
    "verify_password_hashing": true,
    "verify_session_security": true,
    "verify_file_upload_security": true,
    "verify_sensitive_data_exposure": true,
    "scan_for_hardcoded_secrets": true
  },
  "feature_audit": {
    "verify_branch_management_module": true,
    "verify_book_management_module": true,
    "verify_member_management_module": true,
    "verify_circulation_module": true,
    "verify_reservation_module": true,
    "verify_fine_management_module": true,
    "verify_digital_library_module": true,
    "verify_reporting_module": true,
    "verify_notification_module": true,
    "verify_audit_log_module": true
  },
  "quality_audit": {
    "detect_dead_code": true,
    "detect_duplicate_code": true,
    "detect_unused_components": true,
    "detect_unused_routes": true,
    "detect_unused_tables": true,
    "detect_n_plus_one_queries": true,
    "detect_missing_indexes": true,
    "detect_large_controller_classes": true,
    "detect_architecture_violations": true
  },
  "performance_audit": {
    "verify_database_query_optimization": true,
    "verify_pagination": true,
    "verify_lazy_loading": true,
    "verify_asset_optimization": true,
    "verify_queue_processing": true,
    "verify_cache_usage": true
  },
  "deployment_audit": {
    "verify_env_configuration": true,
    "verify_queue_configuration": true,
    "verify_cron_configuration": true,
    "verify_storage_configuration": true,
    "verify_logging_configuration": true,
    "verify_ssl_readiness": true,
    "verify_production_readiness": true
  },
  "required_report_sections": [
    "executive_summary",
    "overall_compliance_score",
    "frontend_compliance_score",
    "backend_compliance_score",
    "database_compliance_score",
    "security_compliance_score",
    "feature_completion_matrix",
    "missing_features",
    "architecture_violations",
    "database_issues",
    "security_vulnerabilities",
    "performance_bottlenecks",
    "code_quality_issues",
    "ui_ux_issues",
    "branding_issues",
    "production_risks",
    "critical_bugs",
    "medium_priority_issues",
    "low_priority_issues",
    "recommended_fixes",
    "implementation_gap_analysis",
    "production_readiness_score",
    "final_verdict"
  ],
  "scoring_model": {
    "frontend_weight": 15,
    "backend_weight": 20,
    "database_weight": 15,
    "security_weight": 20,
    "feature_completion_weight": 20,
    "performance_weight": 5,
    "deployment_weight": 5
  },
  "final_verdict_categories": [
    "not_ready_for_testing",
    "ready_for_internal_testing",
    "ready_for_uat",
    "ready_for_staging",
    "ready_for_production"
  ],
  "strict_rules": [
    "do_not_assume_features_exist",
    "verify_every_requirement_against_code",
    "identify_all_missing_items",
    "provide_file_level_findings",
    "provide_module_level_findings",
    "provide_risk_severity_levels",
    "provide_fix_recommendations",
    "calculate_real_compliance_scores",
    "calculate_real_production_readiness_score"
  ]
}